# Frontend public configuration. Backend secrets belong to ExamcureBe/.env.
NEXT_PUBLIC_API_URL=http://localhost:5010/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Only needed when Google login uses the legacy ExamcureBe /Auth/google-login flow.
# This is a public OAuth Client ID, not a Google API key or client secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID.apps.googleusercontent.com
