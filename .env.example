# Frontend public configuration. Backend secrets belong to ExamcureBe/.env.
# Local: http://localhost:5010/api/v1
# Render: https://<your-render-service>.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:5010/api/v1
# Required. Use the SAME project as SUPABASE_URL in the backend.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Enable Google in Supabase Auth > Providers; no browser Google client ID needed.
