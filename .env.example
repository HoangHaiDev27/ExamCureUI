# Browser requests go through Next.js to keep HttpOnly cookies on the frontend origin.
NEXT_PUBLIC_API_URL=/api/v1
# Server-only backend origin; no secrets here. Rebuild after changing this URL.
EXAMCURE_API_URL=http://localhost:5010
# Set true only after configuring the three Google OAuth variables in ExamcureBe.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
